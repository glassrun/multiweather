# Postgres (see docker-compose.yml for local defaults)
DATABASE_URL="postgresql://weather:weather@localhost:5432/weather_consensus"

# Redis
REDIS_URL="redis://localhost:6379"

# Next-Auth / Auth.js
# Generate with: npx auth secret
AUTH_SECRET=""

# --- Weather providers ---
# Open-Meteo and NWS need no API key and are always active.

# OpenWeatherMap (free tier: https://openweathermap.org/api)
OPENWEATHERMAP_API_KEY=""

# AccuWeather (free dev tier: https://developer.accuweather.com/) — low volume, optional
ACCUWEATHER_API_KEY=""

# WeatherAPI.com (free tier: https://www.weatherapi.com/) — used in place of Weather
# Underground, whose public API is no longer available for new signups
WEATHERAPI_API_KEY=""

# Sentry (optional)
SENTRY_DSN=""

# Public URL this deploys at (optional) - used for SEO metadata (canonical
# links, OG). Leave unset for local dev.
SITE_URL=""
