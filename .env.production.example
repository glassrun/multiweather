# Used by docker-compose.prod.yml. Copy to `.env` on the VPS (next to
# docker-compose.prod.yml) and fill in real values - DATABASE_URL/REDIS_URL
# are assembled automatically from these, pointing at the `postgres`/`redis`
# service names on the compose network.

POSTGRES_USER=weather
POSTGRES_PASSWORD=
POSTGRES_DB=weather_consensus

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Only needed if this host already has something on port 3000 / should stay
# behind an existing reverse proxy, e.g. APP_BIND=127.0.0.1:3010
APP_BIND=

OPENWEATHERMAP_API_KEY=
ACCUWEATHER_API_KEY=
WEATHERAPI_API_KEY=
SENTRY_DSN=

# Public URL this deploys at - used for SEO metadata (canonical links, OG).
# e.g. SITE_URL=https://weather.promptbox.club
SITE_URL=
